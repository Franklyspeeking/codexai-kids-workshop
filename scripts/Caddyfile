codexai.site {
    encode gzip zstd
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
    }
    @code path *.html *.js *.css *.webmanifest
    header @code Cache-Control "no-cache"
    header /money/manifest.webmanifest Content-Type application/manifest+json
    @works path /works/* /projects/* /share/* /collection/*
    header @works Content-Security-Policy "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    header @works X-Robots-Tag "noindex, nofollow, noarchive"
    header @works Referrer-Policy no-referrer
    @gallery path /gallery/*
    header @gallery Content-Security-Policy "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    header @gallery Referrer-Policy no-referrer
    @preview path /preview/*
    header @preview Content-Security-Policy "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'none'; worker-src 'none'; form-action 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    handle /teacher/* {
        redir https://www.codexai.site{uri} 308
    }
    handle /student/* {
        redir https://www.codexai.site{uri} 308
    }
    handle /api/student/* {
        respond "" 404
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8766
    }
    handle /sitemap.xml {
        reverse_proxy 127.0.0.1:8766
    }
    handle /courses/ {
        root * /srv/codexai/current
        file_server
    }
    handle /courses/money/* {
        root * /srv/codexai/current
        file_server
    }
    handle /courses/* {
        reverse_proxy 127.0.0.1:8766
    }
    handle /preview/* {
        reverse_proxy 127.0.0.1:8766
    }
    handle /share/* {
        reverse_proxy 127.0.0.1:8766
    }
    handle /gallery/* {
        reverse_proxy 127.0.0.1:8766
    }
    handle /collection/* {
        reverse_proxy 127.0.0.1:8766
    }
    handle /works/* {
        reverse_proxy 127.0.0.1:8766
    }
    handle /projects/* {
        reverse_proxy 127.0.0.1:8766
    }
    handle {
        root * /srv/codexai/current
        file_server
    }
}

www.codexai.site {
    encode gzip zstd
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Cache-Control "no-store"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8766
    }
    handle /preview/* {
        redir https://codexai.site{uri} 308
    }
    handle /teacher/* {
        root * /srv/codexai/current
        file_server
    }
    handle /student/* {
        root * /srv/codexai/current
        file_server
    }
    handle /style.css {
        root * /srv/codexai/current
        file_server
    }
    handle /assets/* {
        root * /srv/codexai/current
        file_server
    }
    handle {
        redir https://codexai.site{uri} 308
    }
}
